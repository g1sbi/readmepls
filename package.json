{
  "name": "readmepls",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --pretty",
    "lint": "prettier --check . && eslint .",
    "env:check": "node scripts/env-parity-check.mjs",
    "smoke": "bash scripts/smoke-test.sh",
    "deploy:staging": "gh workflow run docker-publish.yml --ref develop",
    "docker:dev": "docker compose -f compose.yml -f compose.dev.yml up -d --build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.0"
  }
}
